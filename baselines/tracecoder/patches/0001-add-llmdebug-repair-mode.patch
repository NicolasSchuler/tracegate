+def _limit_display_output(text: str) -> str:
+    normalized = str(text or "").strip()
+    if not normalized:
+        return ""
+    max_lines = _env_positive_int("TRACECODER_INSTRUMENTATION_OUTPUT_MAX_LINES", default=80)
+    max_chars = _env_positive_int("TRACECODER_INSTRUMENTATION_OUTPUT_MAX_CHARS", default=12000)
+    lines = normalized.splitlines()
+    if len(lines) > max_lines:
+        omitted = len(lines) - max_lines
+        lines = [f"... ({omitted} earlier lines omitted)"] + lines[-max_lines:]
+    limited = "\n".join(lines).strip()
+    if len(limited) <= max_chars:
+        return limited
+    if max_chars <= 3:
+        return limited[-max_chars:]
+    return "..." + limited[-(max_chars - 3) :]
 
