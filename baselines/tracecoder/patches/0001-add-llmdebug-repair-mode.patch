+def save_metrics_sidecar(metrics, filename):
+    """
+    Saves timeout-safe telemetry to a JSON sidecar via atomic replacement.
+    """
+    if not filename:
+        return
+
+    temp_name = None
+    try:
+        output_dir = os.path.dirname(filename)
+        if output_dir and not os.path.exists(output_dir):
+            os.makedirs(output_dir)
+
+        with tempfile.NamedTemporaryFile(
+            "w",
+            encoding="utf-8",
+            delete=False,
+            dir=output_dir or None,
+            prefix=".llmdebug_metrics_",
+            suffix=".json",
+        ) as handle:
+            json.dump(metrics, handle)
+            temp_name = handle.name
+        os.replace(temp_name, filename)
+    except Exception as e:
+        print(f"Error saving metrics sidecar to {filename}: {e}")
+        if temp_name and os.path.exists(temp_name):
