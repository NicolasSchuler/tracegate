+def _env_positive_int(name: str, *, default: int) -> int:
+    raw_value = os.getenv(name, "").strip()
+    if not raw_value:
+        return default
+    try:
+        value = int(raw_value)
+    except ValueError:
+        return default
+    return max(1, value)
+
+
+def _compact_text(text: str, *, max_chars: int) -> str:
+    normalized = str(text or "").strip()
+    if len(normalized) <= max(1, int(max_chars)):
+        return normalized
+    if max_chars <= 3:
+        return normalized[: max(0, int(max_chars))]
+    return normalized[: max(0, int(max_chars)) - 3].rstrip() + "..."
+
+
+def _tail_text(text: str, *, max_chars: int) -> str:
+    normalized = str(text or "").strip()
+    limit = max(1, int(max_chars))
+    if len(normalized) <= limit:
+        return normalized
+    if limit <= 3:
+        return normalized[-limit:]
+    return "..." + normalized[-(limit - 3) :]
+
+
+def _tail_section(label: str, text: str, *, max_chars: int) -> str:
+    normalized = str(text or "").strip()
+    if not normalized:
+        return ""
+    return f"{label} tail:\n{_tail_text(normalized, max_chars=max_chars)}"
+
