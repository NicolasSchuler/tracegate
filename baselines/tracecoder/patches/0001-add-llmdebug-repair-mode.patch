+def _parse_implementation_output(response_text: str) -> str:
+    """
+    Parses the LLM's response from the implementation prompt to extract the full code.
+    Tries multiple strategies with decreasing specificity.
+    """
+    # Strategy 1: Look for the CODE: block with ```python (strict format)
+    full_code_match = re.search(r"CODE:\s*```python\n(.*?)\n```", response_text, re.DOTALL)
+    if full_code_match:
+        return full_code_match.group(1).strip()
+
+    # Strategy 2: CODE: with ``` without language tag
+    full_code_match = re.search(r"CODE:\s*```\n(.*?)\n```", response_text, re.DOTALL)
+    if full_code_match:
+        return full_code_match.group(1).strip()
+
+    # Strategy 3: CODE: with flexible whitespace and newlines before fence
+    full_code_match = re.search(
+        r"CODE:\s*\n*\s*```(?:python)?\s*\n(.*?)\n\s*```", response_text, re.DOTALL
+    )
+    if full_code_match:
+        return full_code_match.group(1).strip()
+
+    # Strategy 4: Everything after CODE: marker, cleaned up
+    code_marker_match = re.search(r"CODE:(.*)", response_text, re.DOTALL | re.IGNORECASE)
+    if code_marker_match:
+        potential_code = code_marker_match.group(1).strip()
+        if potential_code.startswith("```python"):
+            potential_code = potential_code[len("```python"):].strip()
+        if potential_code.startswith("```"):
+            potential_code = potential_code[len("```"):].strip()
+        if potential_code.endswith("```"):
+            potential_code = potential_code[:-len("```")].strip()
+        # Strip END_CODE marker if present
+        end_code_pos = potential_code.find("END_CODE")
+        if end_code_pos >= 0:
+            potential_code = potential_code[:end_code_pos].strip()
+        if potential_code:
+            return potential_code
+
+    # Strategy 5: No CODE: marker — extract the LAST ```python block
+    # (models sometimes skip the marker but still produce fenced code)
+    fenced_blocks = list(re.finditer(
+        r"```python\s*\n(.*?)\n\s*```", response_text, re.DOTALL
+    ))
+    if fenced_blocks:
+        # Prefer the last fenced block (most likely the complete corrected code)
+        candidate = fenced_blocks[-1].group(1).strip()
+        if candidate:
+            return candidate
+
+    # Strategy 6: Last ``` block without language tag
+    fenced_blocks = list(re.finditer(r"```\s*\n(.*?)\n\s*```", response_text, re.DOTALL))
+    if fenced_blocks:
+        candidate = fenced_blocks[-1].group(1).strip()
+        # Only accept if it looks like Python (contains def/class/import or assignment)
+        if candidate and re.search(r"^\s*(def |class |import |from |[a-zA-Z_]\w*\s*=)", candidate, re.MULTILINE):
+            return candidate
+
+    return ""
+
+
