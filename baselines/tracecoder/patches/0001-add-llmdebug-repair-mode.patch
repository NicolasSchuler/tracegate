+_LLMDEBUG_PYTEST_RUNNER = r"""
+import io
+import json
+import sys
+import traceback
+from contextlib import redirect_stderr, redirect_stdout
+
+import pytest
+
+
+class CounterPlugin:
+    def __init__(self):
+        self.total = 0
+        self.failed = set()
+        self.passed = set()
+
+    def pytest_collection_finish(self, session):
+        self.total = len(session.items)
+
+    def pytest_runtest_logreport(self, report):
+        if report.failed and report.when in {"setup", "call", "teardown"}:
+            self.failed.add(report.nodeid)
+            self.passed.discard(report.nodeid)
+        elif report.when == "call" and report.passed and report.nodeid not in self.failed:
+            self.passed.add(report.nodeid)
+
+
+def main() -> int:
+    args = json.loads(sys.argv[1])
+    plugin = CounterPlugin()
+    stdout_buffer = io.StringIO()
+    stderr_buffer = io.StringIO()
+    payload = {
+        "exitcode": 1,
+        "stdout": "",
+        "stderr": "",
+        "passed_count": 0,
+        "failed_count": 0,
+        "total_count": 0,
+    }
+    try:
+        with redirect_stdout(stdout_buffer), redirect_stderr(stderr_buffer):
+            exitcode = pytest.main(args, plugins=[plugin])
+        payload["exitcode"] = int(exitcode)
+    except BaseException as exc:
+        payload["error"] = f"{type(exc).__name__}: {exc}"
+        payload["traceback"] = traceback.format_exc()
+    payload["stdout"] = stdout_buffer.getvalue()
+    payload["stderr"] = stderr_buffer.getvalue()
+    payload["total_count"] = int(plugin.total)
+    payload["passed_count"] = len(plugin.passed)
+    payload["failed_count"] = max(len(plugin.failed), payload["total_count"] - payload["passed_count"])
+    payload["failed_nodeids"] = sorted(plugin.failed)
+    sys.stdout.write(json.dumps(payload))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
+"""
+
+
+def _normalize_python_args(problem_data: dict) -> list[str]:
+    python_args = [str(arg) for arg in problem_data.get("python_args", []) if str(arg)]
+    if python_args[:2] != ["-m", "pytest"]:
+        raise ValueError(f"unsupported python_args for llmdebug TraceCoder run: {python_args!r}")
+    return python_args[2:] or ["-q", "test_buggy.py"]
+
+
+def _decode_case_file(row: dict) -> tuple[str, bytes]:
+    path = str(row.get("path") or "")
+    encoding = str(row.get("encoding") or "utf-8")
+    content = row.get("content")
+    if encoding == "base64":
+        payload = base64.b64decode(str(content or "").encode("ascii"))
+    else:
+        payload = str(content or "").encode("utf-8")
+    return path, payload
+
+
+def _materialize_llmdebug_workspace(problem_data: dict, code_string: str) -> tuple[tempfile.TemporaryDirectory[str], Path]:
+    temp_dir = tempfile.TemporaryDirectory(prefix="tracecoder_llmdebug_")
+    work_dir = Path(temp_dir.name)
+    files = problem_data.get("files", [])
+    if not isinstance(files, list):
+        raise ValueError("llmdebug problem_data.files must be a list")
+    for row in files:
+        if not isinstance(row, dict):
+            continue
+        relative_path, payload = _decode_case_file(row)
+        if not relative_path:
+            continue
+        path = work_dir / relative_path
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_bytes(payload)
+    (work_dir / "buggy.py").write_text(code_string, encoding="utf-8")
+    return temp_dir, work_dir
+
+
+def run_llmdebug_pytest_case(problem_data: dict, code_string: str, timeout_seconds: int = 10) -> dict:
+    temp_dir, work_dir = _materialize_llmdebug_workspace(problem_data, code_string)
