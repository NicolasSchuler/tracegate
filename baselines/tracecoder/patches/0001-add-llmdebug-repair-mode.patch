@@ -0,0 +1,471 @@
+from __future__ import annotations
+
+import ast
+import os
+import re
+from dataclasses import dataclass
+from typing import Any
+
+_DEFAULT_MAX_CHARS = 3000
+_MAX_FALLBACK_LINE_RADIUS = 20
+_MAX_HELPER_BLOCKS = 3
+_FIXTURE_DECORATOR_NAMES = {"fixture"}
+_LINE_ANCHOR_RE = re.compile(r"test_buggy\.py:(\d+)")
+
+
+def _env_positive_int(name: str, *, default: int) -> int:
+    raw_value = os.getenv(name, "").strip()
+    if not raw_value:
+        return default
+    try:
+        value = int(raw_value)
+    except ValueError:
+        return default
+    return max(1, value)
+
+
+@dataclass(frozen=True)
+class _SelectedBlock:
+    start: int
+    end: int
+    text: str
+    name: str
+    priority: int
+    is_fixture: bool = False
+
+
+@dataclass(frozen=True)
+class _ClassSelection:
+    start: int
+    header: str
+    methods: list[_SelectedBlock]
+    name: str
+
+
+def build_exact_test_context(
+    test_code: str,
+    *,
+    failed_nodeids: list[str] | tuple[str, ...] | None,
+    failure_output: str,
+    max_chars: int | None = None,
+) -> tuple[str, dict[str, Any]]:
+    normalized_test_code = str(test_code or "").strip()
+    limit = (
+        max(1, int(max_chars))
+        if max_chars is not None
+        else _env_positive_int("TRACECODER_EXACT_TEST_CONTEXT_MAX_CHARS", default=_DEFAULT_MAX_CHARS)
+    )
+    normalized_nodeids: list[str] = []
+    for nodeid in (failed_nodeids or []):
+        normalized = str(nodeid).strip()
+        if normalized and normalized not in normalized_nodeids:
+            normalized_nodeids.append(normalized)
+
+    if not normalized_test_code:
+        return "", {
+            "source": "empty",
+            "chars": 0,
+            "truncated": False,
+            "selected_nodeids": [],
+            "helper_names": [],
+        }
+
+    if len(normalized_test_code) <= limit:
+        return normalized_test_code, {
+            "source": "full_file",
+            "chars": len(normalized_test_code),
+            "truncated": False,
+            "selected_nodeids": normalized_nodeids,
+            "helper_names": [],
+        }
+
+    try:
+        tree = ast.parse(normalized_test_code)
+    except SyntaxError:
+        rendered = _render_line_anchor_fallback(
+            normalized_test_code,
+            failure_output=failure_output,
+            max_chars=limit,
+        )
+        return rendered, {
+            "source": "line_anchors_fallback",
+            "chars": len(rendered),
+            "truncated": bool(rendered and rendered != normalized_test_code),
+            "selected_nodeids": normalized_nodeids,
+            "helper_names": [],
+        }
+
+    layout = _build_layout(normalized_test_code, tree=tree)
+    if not layout:
+        rendered = _render_line_anchor_fallback(
+            normalized_test_code,
+            failure_output=failure_output,
+            max_chars=limit,
+        )
+        return rendered, {
+            "source": "line_anchors_fallback",
+            "chars": len(rendered),
+            "truncated": bool(rendered and rendered != normalized_test_code),
+            "selected_nodeids": normalized_nodeids,
+            "helper_names": [],
+        }
+
+    selected_nodeids: list[str] = []
+    selected_classes: dict[str, _ClassSelection] = {}
+    selected_top_level_blocks: list[_SelectedBlock] = []
+    remaining_blocks_by_name = dict(layout["top_level_by_name"])
+    class_methods_by_name = dict(layout["class_methods_by_name"])
+    classes_by_name = dict(layout["classes_by_name"])
+
+    for nodeid in normalized_nodeids:
+        matched = _select_from_nodeid(
+            nodeid,
+            classes_by_name=classes_by_name,
+            class_methods_by_name=class_methods_by_name,
+            remaining_blocks_by_name=remaining_blocks_by_name,
+        )
+        if not matched:
+            continue
+        selection_kind, selection_value = matched
+        selected_nodeids.append(nodeid)
+        if selection_kind == "class":
+            existing = selected_classes.get(selection_value.name)
+            if existing is None:
+                selected_classes[selection_value.name] = selection_value
+            else:
+                merged_methods = _merge_methods(existing.methods, selection_value.methods)
+                selected_classes[selection_value.name] = _ClassSelection(
+                    start=existing.start,
+                    header=existing.header,
+                    methods=merged_methods,
+                    name=existing.name,
+                )
+        else:
+            if selection_value.name not in {item.name for item in selected_top_level_blocks}:
+                selected_top_level_blocks.append(selection_value)
+
+    primary_sections: list[str] = []
+    current_chars = 0
+
+    for section in _render_primary_sections(
+        selected_classes=list(selected_classes.values()),
+        selected_top_level_blocks=selected_top_level_blocks,
+    ):
+        if not section:
+            continue
+        primary_sections, current_chars = _append_section(
+            primary_sections,
+            current_chars=current_chars,
+            section=section,
+            max_chars=limit,
+        )
+
+    source = "nodeids"
+    if not primary_sections:
+        fallback_section = _render_line_anchor_fallback(
+            normalized_test_code,
+            failure_output=failure_output,
+            max_chars=limit,
+        )
+        if fallback_section:
+            primary_sections = [fallback_section]
+            current_chars = len(fallback_section)
+            source = "line_anchors_fallback"
+
+    helper_names: list[str] = []
+    if primary_sections:
+        imports_block = str(layout["imports_block"])
+        if imports_block:
+            primary_sections, current_chars = _append_section(
+                primary_sections,
+                current_chars=current_chars,
+                section=imports_block,
+                max_chars=limit,
+            )
+
+        helper_candidates = _collect_referenced_helpers(
+            primary_sections=primary_sections,
+            top_level_blocks=layout["top_level_blocks"],
+        )
+        for helper_block in helper_candidates[:_MAX_HELPER_BLOCKS]:
+            next_sections, next_chars = _append_section(
+                primary_sections,
+                current_chars=current_chars,
+                section=helper_block.text,
+                max_chars=limit,
+            )
+            if next_chars == current_chars:
+                continue
+            primary_sections = next_sections
+            current_chars = next_chars
+            helper_names.append(helper_block.name)
+
+    rendered = "\n\n".join(section for section in primary_sections if section).strip()
+    if not rendered:
+        return "", {
+            "source": "empty",
+            "chars": 0,
+            "truncated": False,
+            "selected_nodeids": selected_nodeids,
+            "helper_names": [],
+        }
+    return rendered, {
+        "source": source,
+        "chars": len(rendered),
+        "truncated": len(rendered) < len(normalized_test_code),
+        "selected_nodeids": selected_nodeids,
+        "helper_names": helper_names,
+    }
+
+
+def _build_layout(test_code: str, *, tree: ast.AST) -> dict[str, Any]:
+    lines = test_code.splitlines()
+    top_level_blocks: list[_SelectedBlock] = []
+    top_level_by_name: dict[str, _SelectedBlock] = {}
+    classes_by_name: dict[str, ast.ClassDef] = {}
+    class_methods_by_name: dict[str, dict[str, _SelectedBlock]] = {}
+    import_lines: list[str] = []
+
+    for stmt in getattr(tree, "body", []):
+        if isinstance(stmt, (ast.Import, ast.ImportFrom)):
+            segment = ast.get_source_segment(test_code, stmt)
+            if segment:
+                import_lines.append(segment.strip())
+            continue
+        if isinstance(stmt, ast.ClassDef):
+            classes_by_name[stmt.name] = stmt
+            class_methods_by_name[stmt.name] = _class_methods(test_code, cls=stmt)
+            if not stmt.name.startswith("Test"):
+                block = _block_from_node(test_code, stmt)
+                if block is not None:
+                    top_level_blocks.append(block)
+                    top_level_by_name[block.name] = block
+            continue
+        if isinstance(stmt, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            block = _block_from_node(test_code, stmt)
+            if block is None:
+                continue
+            top_level_blocks.append(block)
+            top_level_by_name[block.name] = block
+
+    return {
+        "lines": lines,
+        "top_level_blocks": top_level_blocks,
+        "top_level_by_name": top_level_by_name,
+        "classes_by_name": classes_by_name,
+        "class_methods_by_name": class_methods_by_name,
+        "imports_block": "\n".join(import_lines).strip(),
+    }
+
+
+def _class_methods(test_code: str, *, cls: ast.ClassDef) -> dict[str, _SelectedBlock]:
+    methods: dict[str, _SelectedBlock] = {}
+    for stmt in cls.body:
+        if isinstance(stmt, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            block = _block_from_node(test_code, stmt)
+            if block is not None:
+                methods[block.name] = block
+    return methods
+
+
+def _block_from_node(test_code: str, node: ast.AST) -> _SelectedBlock | None:
+    segment = ast.get_source_segment(test_code, node)
+    if not segment:
+        return None
+    start = int(getattr(node, "lineno", 1))
+    end = int(getattr(node, "end_lineno", start))
+    name = str(getattr(node, "name", "") or "")
+    is_fixture = any(
+        _decorator_name(decorator) in _FIXTURE_DECORATOR_NAMES
+        for decorator in getattr(node, "decorator_list", [])
+    )
+    priority = 0 if name.startswith("test") else 1
+    if is_fixture:
+        priority = -1
+    return _SelectedBlock(
+        start=start,
+        end=end,
+        text=segment.strip(),
+        name=name,
+        priority=priority,
+        is_fixture=is_fixture,
+    )
+
+
+def _decorator_name(node: ast.AST) -> str:
+    if isinstance(node, ast.Name):
+        return node.id
+    if isinstance(node, ast.Attribute):
+        return node.attr
+    if isinstance(node, ast.Call):
+        return _decorator_name(node.func)
+    return ""
+
+
+def _select_from_nodeid(
+    nodeid: str,
+    *,
+    classes_by_name: dict[str, ast.ClassDef],
+    class_methods_by_name: dict[str, dict[str, _SelectedBlock]],
+    remaining_blocks_by_name: dict[str, _SelectedBlock],
+) -> tuple[str, Any] | None:
+    parts = [part for part in str(nodeid).split("::") if part]
+    if not parts:
+        return None
+
+    if len(parts) >= 3:
+        class_name = parts[1]
+        method_name = parts[2].split("[", 1)[0]
+        cls = classes_by_name.get(class_name)
+        if cls is None:
+            return None
+        method_map = class_methods_by_name.get(class_name, {})
+        selected_methods: list[_SelectedBlock] = []
+        for support_name in ("setUpClass", "tearDownClass", "setUp", "tearDown"):
+            block = method_map.get(support_name)
+            if block is not None:
+                selected_methods.append(block)
+        selected_methods.extend(
+            block
+            for name, block in method_map.items()
+            if name == method_name or name.startswith("test")
+            and name == method_name
+        )
+        seen: set[str] = set()
+        ordered_methods: list[_SelectedBlock] = []
+        for block in sorted(selected_methods, key=lambda item: (item.start, item.end)):
+            if block.name in seen:
+                continue
+            seen.add(block.name)
+            ordered_methods.append(block)
+        if not ordered_methods:
+            return None
+        header = f"class {class_name}:"
+        return "class", _ClassSelection(
+            start=int(getattr(cls, "lineno", 1)),
+            header=header,
+            methods=ordered_methods,
+            name=class_name,
+        )
+
+    if len(parts) >= 2:
+        test_name = parts[1].split("[", 1)[0]
+        block = remaining_blocks_by_name.get(test_name)
+        if block is None:
+            return None
+        return "top_level", block
+
+    return None
+
+
+def _render_primary_sections(
+    *,
+    selected_classes: list[_ClassSelection],
+    selected_top_level_blocks: list[_SelectedBlock],
+) -> list[str]:
+    sections: list[str] = []
+    for block in sorted(selected_top_level_blocks, key=lambda item: (item.start, item.end)):
+        sections.append(block.text)
+    for class_selection in sorted(selected_classes, key=lambda item: (item.start, item.name)):
+        rendered = [class_selection.header]
+        for method in sorted(class_selection.methods, key=lambda item: (item.start, item.end)):
+            rendered.append(_indent_block(method.text))
+        sections.append("\n".join(rendered).strip())
+    return sections
+
+
+def _merge_methods(
+    existing_methods: list[_SelectedBlock],
+    new_methods: list[_SelectedBlock],
+) -> list[_SelectedBlock]:
+    merged: list[_SelectedBlock] = []
+    seen: set[str] = set()
+    for block in sorted([*existing_methods, *new_methods], key=lambda item: (item.start, item.end)):
+        if block.name in seen:
+            continue
+        seen.add(block.name)
+        merged.append(block)
+    return merged
+
+
+def _append_section(
+    sections: list[str],
+    *,
+    current_chars: int,
+    section: str,
+    max_chars: int,
+) -> tuple[list[str], int]:
+    normalized_section = str(section or "").strip()
+    if not normalized_section:
+        return sections, current_chars
+    candidate = "\n\n".join([*sections, normalized_section]).strip()
+    if len(candidate) > max_chars:
+        return sections, current_chars
+    return [*sections, normalized_section], len(candidate)
+
+
+def _collect_referenced_helpers(
+    *,
+    primary_sections: list[str],
+    top_level_blocks: list[_SelectedBlock],
+) -> list[_SelectedBlock]:
+    combined_text = "\n".join(primary_sections)
+    helper_candidates = [
+        block
+        for block in top_level_blocks
+        if not block.name.startswith("test") and re.search(rf"\b{re.escape(block.name)}\b", combined_text)
+    ]
+    return sorted(
+        helper_candidates,
+        key=lambda block: (block.priority, block.start, block.end),
+    )
+
+
+def _render_line_anchor_fallback(test_code: str, *, failure_output: str, max_chars: int) -> str:
+    lines = test_code.splitlines()
+    if not lines:
+        return ""
+    anchored_ranges = _line_anchor_ranges(
+        failure_output=failure_output,
+        line_count=len(lines),
+    )
+    if not anchored_ranges:
+        return test_code[:max_chars].rstrip()
+    sections: list[str] = []
+    for start, end in anchored_ranges:
+        excerpt_lines = lines[start - 1 : end]
+        rendered = [f"# test_buggy.py:{start}-{end}", *excerpt_lines]
+        candidate = "\n\n".join([*sections, "\n".join(rendered).strip()]).strip()
+        if len(candidate) > max_chars:
+            break
+        sections.append("\n".join(rendered).strip())
+    if not sections:
+        start, end = anchored_ranges[0]
+        excerpt_lines = lines[start - 1 : end]
+        return "\n".join([f"# test_buggy.py:{start}-{end}", *excerpt_lines]).strip()[:max_chars].rstrip()
+    return "\n\n".join(sections).strip()
+
+
+def _line_anchor_ranges(*, failure_output: str, line_count: int) -> list[tuple[int, int]]:
+    anchors = sorted(
+        {
+            max(1, min(line_count, int(match.group(1))))
+            for match in _LINE_ANCHOR_RE.finditer(str(failure_output or ""))
+        }
+    )
+    if not anchors:
+        return []
+    ranges: list[tuple[int, int]] = []
+    for anchor in anchors:
+        start = max(1, anchor - _MAX_FALLBACK_LINE_RADIUS)
+        end = min(line_count, anchor + _MAX_FALLBACK_LINE_RADIUS)
+        if ranges and start <= ranges[-1][1] + 1:
+            previous_start, previous_end = ranges[-1]
+            ranges[-1] = (previous_start, max(previous_end, end))
+            continue
+        ranges.append((start, end))
+    return ranges
+
+
+def _indent_block(text: str) -> str:
+    return "\n".join(f"    {line}" if line else "" for line in str(text).splitlines())
diff --git a/src/progress.py b/src/progress.py
new file mode 100644
index 0000000..e788970
--- /dev/null
+++ b/src/progress.py
@@ -0,0 +1,307 @@
+from __future__ import annotations
+
+import itertools
+import re
+import sys
+import threading
+import time
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass, field
+from typing import Any
+
+PROGRESS_PREFIX = "[TRACECODER_PROGRESS]"
+PROGRESS_HEARTBEAT_SEC = 5.0
+
+_PROGRESS_LOCK = threading.RLock()
+_ACTIVE_SPANS: list["_SpanRecord"] = []
+_LAST_PROGRESS_STATE: dict[str, Any] = {}
+_REFRESH_CALLBACK: Callable[[], None] | None = None
+_SPAN_IDS = itertools.count(1)
+
+
+def _sanitize_progress_value(value: Any) -> str:
+    if value is None:
+        return ""
+    if isinstance(value, bool):
+        return "true" if value else "false"
+    if isinstance(value, float):
+        text = f"{value:.1f}"
+    else:
+        text = str(value)
+    collapsed = " ".join(text.strip().split())
+    if not collapsed:
+        return ""
+    return re.sub(r"[^A-Za-z0-9._:/@+\-]", "_", collapsed)
+
+
+@dataclass
+class _SpanRecord:
+    span_id: int
+    task_id: str
+    phase: str
+    wait_target: str
+    attempt: int
+    started_at: float
+    extra: dict[str, str] = field(default_factory=dict)
+
+
+def reset_progress_state() -> None:
+    with _PROGRESS_LOCK:
+        _ACTIVE_SPANS.clear()
+        _LAST_PROGRESS_STATE.clear()
+
+
+def set_progress_refresh_callback(callback: Callable[[], None] | None) -> None:
+    global _REFRESH_CALLBACK
+    with _PROGRESS_LOCK:
+        _REFRESH_CALLBACK = callback
+
+
+def _refresh_sidecar() -> None:
+    callback = None
+    with _PROGRESS_LOCK:
+        callback = _REFRESH_CALLBACK
+    if callback is None:
+        return
+    try:
+        callback()
+    except Exception:
+        return
+
+
+def _active_span_locked() -> _SpanRecord | None:
+    if not _ACTIVE_SPANS:
+        return None
+    return _ACTIVE_SPANS[-1]
+
+
+def current_progress_snapshot(*, task_id: str | None = None) -> dict[str, Any]:
+    with _PROGRESS_LOCK:
+        snapshot: dict[str, Any] = {}
+        current = _active_span_locked()
+        last_state = dict(_LAST_PROGRESS_STATE)
+        if current is not None and (task_id is None or current.task_id == task_id):
+            snapshot["current_phase"] = current.phase
+            snapshot["current_attempt"] = current.attempt
+            snapshot["current_wait_target"] = current.wait_target
+            snapshot["phase_elapsed_sec"] = max(0.0, time.perf_counter() - current.started_at)
+        elif task_id is None or str(last_state.get("task_id") or "") == str(task_id):
+            phase = str(last_state.get("phase") or "").strip()
+            wait_target = str(last_state.get("wait_target") or "").strip()
+            attempt = last_state.get("attempt")
+            elapsed_sec = last_state.get("elapsed_sec")
+            if phase:
+                snapshot["current_phase"] = phase
+            if wait_target:
+                snapshot["current_wait_target"] = wait_target
+            if isinstance(attempt, int):
+                snapshot["current_attempt"] = max(0, attempt)
+            if isinstance(elapsed_sec, (int, float)):
+                snapshot["phase_elapsed_sec"] = max(0.0, float(elapsed_sec))
+        last_message = str(last_state.get("message") or "").strip()
+        if last_message and (task_id is None or str(last_state.get("task_id") or "") == str(task_id)):
+            snapshot["last_progress_message"] = last_message
+        return snapshot
+
+
+def emit_progress(
+    *,
+    task_id: str,
+    phase: str,
+    wait_target: str,
+    status: str,
+    attempt: int = 0,
+    elapsed_sec: float = 0.0,
+    extra: Mapping[str, Any] | None = None,
+    stream: Any | None = None,
+) -> str:
+    task_value = _sanitize_progress_value(task_id) or "unknown_task"
+    phase_value = _sanitize_progress_value(phase) or "unknown_phase"
+    wait_value = _sanitize_progress_value(wait_target) or "unknown_wait"
+    status_value = _sanitize_progress_value(status) or "update"
+    attempt_value = max(0, int(attempt))
+    elapsed_value = max(0.0, float(elapsed_sec))
+
+    ordered_fields: list[tuple[str, str]] = [
+        ("task", task_value),
+        ("phase", phase_value),
+        ("wait", wait_value),
+        ("status", status_value),
+        ("attempt", str(attempt_value)),
+        ("elapsed", f"{elapsed_value:.1f}"),
+    ]
+    normalized_extra: dict[str, str] = {}
+    if isinstance(extra, Mapping):
+        for key, raw_value in extra.items():
+            key_text = _sanitize_progress_value(key)
+            value_text = _sanitize_progress_value(raw_value)
+            if key_text and value_text:
+                normalized_extra[key_text] = value_text
+    for key in sorted(normalized_extra):
+        ordered_fields.append((key, normalized_extra[key]))
+    message = " ".join(f"{key}={value}" for key, value in ordered_fields)
+    line = f"{PROGRESS_PREFIX} {message}"
+    output = stream if stream is not None else sys.stderr
+    try:
+        output.write(line + "\n")
+        output.flush()
+    except Exception:
+        pass
+
+    with _PROGRESS_LOCK:
+        _LAST_PROGRESS_STATE.clear()
+        _LAST_PROGRESS_STATE.update(
+            {
+                "task_id": task_value,
+                "phase": phase_value,
+                "wait_target": wait_value,
+                "status": status_value,
+                "attempt": attempt_value,
+                "elapsed_sec": elapsed_value,
+                "message": message,
+                **normalized_extra,
+            }
+        )
+    _refresh_sidecar()
+    return line
+
+
+class _ProgressSpan:
+    def __init__(
+        self,
+        *,
+        task_id: str,
+        phase: str,
+        wait_target: str,
+        attempt: int = 0,
+        extra: Mapping[str, Any] | None = None,
+        heartbeat_sec: float = PROGRESS_HEARTBEAT_SEC,
+    ) -> None:
+        self.task_id = str(task_id or "unknown_task")
+        self.phase = str(phase or "unknown_phase")
+        self.wait_target = str(wait_target or "unknown_wait")
+        self.attempt = max(0, int(attempt))
+        self._started_at = 0.0
+        self._finished = False
+        self._heartbeat_sec = max(0.1, float(heartbeat_sec))
+        self._extra: dict[str, str] = {}
+        if isinstance(extra, Mapping):
+            for key, value in extra.items():
+                key_text = _sanitize_progress_value(key)
+                value_text = _sanitize_progress_value(value)
+                if key_text and value_text:
+                    self._extra[key_text] = value_text
+        self._stop_event = threading.Event()
+        self._thread: threading.Thread | None = None
+        self._span_id = next(_SPAN_IDS)
+
+    def __enter__(self) -> "_ProgressSpan":
+        self._started_at = time.perf_counter()
+        with _PROGRESS_LOCK:
+            _ACTIVE_SPANS.append(
+                _SpanRecord(
+                    span_id=self._span_id,
+                    task_id=self.task_id,
+                    phase=self.phase,
+                    wait_target=self.wait_target,
+                    attempt=self.attempt,
+                    started_at=self._started_at,
+                    extra=dict(self._extra),
+                )
+            )
+        emit_progress(
+            task_id=self.task_id,
+            phase=self.phase,
+            wait_target=self.wait_target,
+            status="start",
+            attempt=self.attempt,
+            elapsed_sec=0.0,
+            extra=self._extra,
+        )
+        self._thread = threading.Thread(
+            target=self._heartbeat_loop,
+            name=f"tracecoder-progress-{self._span_id}",
+            daemon=True,
+        )
+        self._thread.start()
+        return self
+
+    def __exit__(self, exc_type, exc, tb) -> None:
+        self.finish()
+
+    def update(self, **extra: Any) -> None:
+        updated: dict[str, str] = {}
+        for key, value in extra.items():
+            key_text = _sanitize_progress_value(key)
+            value_text = _sanitize_progress_value(value)
+            if key_text and value_text:
+                updated[key_text] = value_text
+        if not updated:
+            return
+        with _PROGRESS_LOCK:
+            self._extra.update(updated)
+            for record in reversed(_ACTIVE_SPANS):
+                if record.span_id == self._span_id:
+                    record.extra.update(updated)
+                    break
+
+    def finish(self, *, extra: Mapping[str, Any] | None = None) -> None:
+        if self._finished:
+            return
+        self._finished = True
+        if isinstance(extra, Mapping):
+            self.update(**dict(extra))
+        self._stop_event.set()
+        if self._thread is not None:
+            self._thread.join(timeout=0.2)
+        elapsed_sec = max(0.0, time.perf_counter() - self._started_at)
+        emit_progress(
+            task_id=self.task_id,
+            phase=self.phase,
+            wait_target=self.wait_target,
+            status="finish",
+            attempt=self.attempt,
+            elapsed_sec=elapsed_sec,
+            extra=self._extra,
+        )
+        with _PROGRESS_LOCK:
+            for index in range(len(_ACTIVE_SPANS) - 1, -1, -1):
+                if _ACTIVE_SPANS[index].span_id == self._span_id:
+                    _ACTIVE_SPANS.pop(index)
+                    break
+
+    def _heartbeat_loop(self) -> None:
+        while not self._stop_event.wait(self._heartbeat_sec):
+            with _PROGRESS_LOCK:
+                active = _active_span_locked()
+                if active is None or active.span_id != self._span_id:
+                    continue
+                extra = dict(active.extra)
+            emit_progress(
+                task_id=self.task_id,
+                phase=self.phase,
+                wait_target=self.wait_target,
+                status="heartbeat",
+                attempt=self.attempt,
+                elapsed_sec=max(0.0, time.perf_counter() - self._started_at),
+                extra=extra,
+            )
+
+
+def progress_span(
+    *,
+    task_id: str,
+    phase: str,
+    wait_target: str,
+    attempt: int = 0,
+    extra: Mapping[str, Any] | None = None,
+    heartbeat_sec: float = PROGRESS_HEARTBEAT_SEC,
+) -> _ProgressSpan:
+    return _ProgressSpan(
+        task_id=task_id,
+        phase=phase,
+        wait_target=wait_target,
+        attempt=attempt,
+        extra=extra,
+        heartbeat_sec=heartbeat_sec,
+    )
