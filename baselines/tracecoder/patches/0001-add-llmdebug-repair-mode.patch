+from reporting import build_llmdebug_failure_feedback
+from src.traceRunner import run_llmdebug_pytest_case
+
+
+def check_correctness(problem_data: dict, generated_code: str, timeout_seconds: int = 10) -> dict:
+    result = run_llmdebug_pytest_case(problem_data, generated_code, timeout_seconds=timeout_seconds)
+    passed_count = int(result.get("passed_count", 0) or 0)
+    failed_count = int(result.get("failed_count", 0) or 0)
+    total_count = int(result.get("total_count", 0) or 0)
+    stdout_text = str(result.get("stdout") or "").strip()
+    stderr_text = str(result.get("stderr") or "").strip()
+    error_text = str(result.get("error") or "").strip()
+
+    exitcode = int(result.get("exitcode", 1) or 0)
+    result_text = build_llmdebug_failure_feedback(
+        passed_count=passed_count,
+        failed_count=failed_count,
+        total_count=total_count,
+        exitcode=exitcode,
+        timed_out=bool(result.get("timed_out", False)),
+        stdout_text=stdout_text,
+        stderr_text=stderr_text,
+        error_text=error_text,
+    )
+    if not result_text:
+        result_text = "All tests passed." if exitcode == 0 else "Pytest failed without output."
+
+    return {
+        "passed": exitcode == 0,
+        "passed_count": passed_count,
+        "failed_count": failed_count,
+        "total_count": total_count,
+        "result": result_text,
+        "status": "success" if exitcode == 0 else ("timeout" if result.get("timed_out") else "failure"),
+        "prints_output": result_text,
+        "_debug_process_exit_code": exitcode,
+        "_debug_timeout": bool(result.get("timed_out", False)),
+        "_debug_stdout_tail": stdout_text[-2000:],
+        "_debug_stderr_tail": stderr_text[-2000:],
+        "_debug_error_tail": error_text[-1000:],
+        "_debug_failed_nodeids": list(result.get("failed_nodeids") or []),
+    }
