+def _build_metrics_snapshot(
+    *,
+    task_id: str,
+    args,
+    started_at: float,
+    prompt_tokens: int,
+    completion_tokens: int,
+    prompt_chars_total: int,
+    completion_chars_total: int,
+    llm_call_count: int,
+    usage_reported_call_count: int,
+    usage_missing_call_count: int,
+    llm_duration_sec: float,
+    eval_duration_sec: float,
+    attempts_completed: int,
+    status: str = "running",
+    extra: dict[str, Any] | None = None,
+) -> dict[str, Any]:
+    prompt_tokens = max(0, int(prompt_tokens))
+    completion_tokens = max(0, int(completion_tokens))
+    total_tokens = prompt_tokens + completion_tokens
+    prompt_chars_total = max(0, int(prompt_chars_total))
+    completion_chars_total = max(0, int(completion_chars_total))
+    chars_total = prompt_chars_total + completion_chars_total
+    llm_call_count = max(0, int(llm_call_count))
+    usage_reported_call_count = max(0, min(int(usage_reported_call_count), llm_call_count))
