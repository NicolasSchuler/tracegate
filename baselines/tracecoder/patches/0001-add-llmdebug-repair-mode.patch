+def _configured_api_timeout_sec() -> float | None:
+    raw_value = os.getenv("TRACECODER_OPENAI_TIMEOUT_SEC", "").strip()
+    if not raw_value:
+        return None
+    try:
+        timeout_sec = float(raw_value)
+    except ValueError:
+        return None
+    return timeout_sec if timeout_sec > 0.0 else None
+
