+def _usage_mapping(payload: Any) -> dict[str, Any]:
+    if isinstance(payload, dict):
+        return payload
+    model_dump = getattr(payload, "model_dump", None)
+    if callable(model_dump):
+        dumped = model_dump()
+        if isinstance(dumped, dict):
+            return dumped
+    to_dict = getattr(payload, "to_dict", None)
+    if callable(to_dict):
+        dumped = to_dict()
+        if isinstance(dumped, dict):
+            return dumped
+    out: dict[str, Any] = {}
+    for key in (
+        "prompt_tokens",
+        "completion_tokens",
+        "input_tokens",
+        "output_tokens",
+        "total_tokens",
+    ):
+        value = getattr(payload, key, None)
+        if value is not None:
+            out[key] = value
+    return out
+
+
+def _usage_counts_from_payload(payload: Any) -> tuple[int, int, bool]:
+    usage = _usage_mapping(payload)
+    if not usage:
+        return 0, 0, False
+
+    prompt_tokens = _parse_optional_nonnegative_int(usage.get("prompt_tokens"))
+    completion_tokens = _parse_optional_nonnegative_int(usage.get("completion_tokens"))
+    if prompt_tokens is None and completion_tokens is None:
+        prompt_tokens = _parse_optional_nonnegative_int(usage.get("input_tokens"))
+        completion_tokens = _parse_optional_nonnegative_int(usage.get("output_tokens"))
+
+    usage_reported = any(
+        _parse_optional_nonnegative_int(usage.get(key)) is not None
