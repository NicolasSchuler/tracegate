+def _call_generator_timed(
+    prompt: str,
+    status: str,
+    model_name: str,
+    *,
+    task_id: str,
+    phase: str,
+    attempt: int = 0,
+    extra: dict[str, Any] | None = None,
+):
+    started_at = time.perf_counter()
+    with progress_span(
+        task_id=task_id,
+        phase=phase,
+        wait_target="llm_api",
+        attempt=attempt,
+        extra=extra,
+    ) as span:
+        (
+            generated_text,
+            prompt_tokens,
+            completion_tokens,
+            usage_reported,
+            completion_chars,
+            failure_kind,
+            failure_meta,
+        ) = generator(
+            prompt,
+            status,
+            model_name,
+            progress_task_id=task_id,
+            progress_phase=phase,
+            progress_attempt=attempt,
+        )
+        if failure_kind:
+            span.update(failure_kind=failure_kind)
+    return (
+        generated_text,
+        prompt_tokens,
+        completion_tokens,
+        usage_reported,
+        len(prompt or ""),
+        max(0, int(completion_chars or 0)),
+        max(0.0, time.perf_counter() - started_at),
+        str(failure_kind or ""),
+        dict(failure_meta or {}),
+    )
+
+
+def _run_check_correctness_timed(
+    problem_data,
+    candidate_code: str,
+    timeout_seconds: int,
+    check_correctness_func_param: Callable,
+    *,
+    task_id: str,
+    phase: str,
+    attempt: int = 0,
+    extra: dict[str, Any] | None = None,
+):
+    started_at = time.perf_counter()
+    with progress_span(
+        task_id=task_id,
+        phase=phase,
+        wait_target=_execution_wait_target(problem_data),
+        attempt=attempt,
+        extra=extra,
+    ):
+        eval_result = check_correctness_func_param(problem_data, candidate_code, timeout_seconds)
+    return eval_result, max(0.0, time.perf_counter() - started_at)
+
+
+def _llm_failure_stop_reason(failure_kind: str, stage: str) -> str:
+    stage_label = {
+        "direct_generation": "direct generation",
+        "instrumentation": "instrumentation",
+        "analysis_planning": "analysis planning",
+        "code_implementation": "code implementation",
+    }.get(stage, stage.replace("_", " "))
+    if failure_kind == "openai_compat_reasoning_only":
+        return f"OpenAI-compatible server returned reasoning without final content during {stage_label}"
+    if failure_kind == "api_timeout":
+        return f"LLM request timed out during {stage_label}"
+    if failure_kind == "rate_limit":
+        return f"LLM request hit rate limit during {stage_label}"
+    return f"LLM request failed during {stage_label}"
+
+
+def _llm_failure_extra(
+    *,
+    failure_kind: str,
+    stage: str,
+    llm_timeout_count: int,
+    failure_meta: dict[str, Any] | None = None,
+) -> dict[str, Any]:
+    if not failure_kind:
+        return {}
+    extra: dict[str, Any] = {
+        "last_llm_failure_kind": failure_kind,
+        "last_llm_failure_stage": stage,
+    }
+    if llm_timeout_count > 0:
+        extra["llm_timeout_count"] = max(0, int(llm_timeout_count))
+    if failure_meta:
